# Server-side PostgreSQL URL for the private overseas_stories schema.
# Use a dedicated least-privilege database login and require TLS.
DATABASE_URL=postgresql://overseas_story_runner_login.PROJECT_REF:CHANGE_ME@POOLER_HOST:5432/postgres?sslmode=require

# OpenAI-compatible HTTPS gateway used by M2 extraction and M4 localization.
AI_EXTRACTION_ENDPOINT=https://gateway.example/v1/chat/completions
AI_EXTRACTION_API_KEY=CHANGE_ME
AI_EXTRACTION_MODEL=CHANGE_ME

# Disable ambient HTTP(S)_PROXY use by default; set true only on networks that require an outbound proxy.
OUTBOUND_PROXY_ENABLED=false

# Substack content is disabled unless its use is explicitly authorized.
SUBSTACK_CONTENT_AUTHORIZED=false
